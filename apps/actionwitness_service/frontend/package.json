{
  "name": "actionwitness-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal React workspace for the assurance harness (spec v1.9 §8.4, §19.1). WebMCP hook pinned per ADR-0002: use-webmcp-tool@0.2.0 + webmcp-types@0.1.5, tested against Chrome 151.0.0.0 with #enable-webmcp-testing. Cancellation-sensitive tools use direct native registration (ADR-0002 rule 3 split).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/build-e2e-static.mjs && playwright test",
    "test:e2e:ui": "node scripts/build-e2e-static.mjs && playwright test --ui",
    "capture:demo": "node scripts/build-e2e-static.mjs && playwright test -c playwright.demo.config.ts",
    "capture:shopify-demo": "playwright test -c playwright.shopify-demo.config.ts",
    "build": "vite build",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "use-webmcp-tool": "0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "9.17.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.3",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.19.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.4",
    "webmcp-types": "0.1.5"
  }
}
