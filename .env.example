# Copy to .env for local development. NEVER commit .env (see .gitignore).
# Spec refs: §29.1 deployment configuration, FR-099 credential handling.
# Provenance and fail-closed semantics: actionwitness_service/config.py.
# Every module below disables ONLY itself when unset or invalid.

# --- Tier 1: Buggy Store managed target (optional; on by default) -----------
#BUGGY_STORE_ENABLED=true
#BUGGY_STORE_BASE_URL=http://127.0.0.1:8001

# --- Tier 2: external evaluator report import (recorded fixture; no key) ----
#EVALUATOR_IMPORT_ENABLED=true

# --- Tier 3: live LLM benchmark (names only — the credential VALUE belongs
# to the pinned evaluator's own process environment, never the harness) ------
#LIVE_EVALUATOR_ENABLED=false
#LIVE_EVALUATOR_PROVIDER=
#LIVE_EVALUATOR_MODEL=
#LIVE_EVALUATOR_CREDENTIAL_VAR=

# --- Tier 3: external WebMCP surface audit ----------------------------------
#EXTERNAL_AUDIT_ENABLED=false
#EXTERNAL_AUDIT_ALLOWED_ORIGINS=

# --- Tier 3: Shopify development-store module -------------------------------
HARNESS_PUBLIC_ORIGIN=http://localhost:8000
#SHOPIFY_STORE_ORIGIN=https://your-dev-store.myshopify.com
#SHOPIFY_TEST_VARIANT_ID=
#SHOPIFY_EXPECTED_CURRENCY=USD

# --- Tier 3: model-provider credentials (developer/deployment side ONLY; consumed by the
# pinned webmcp-evals execution path, never by the harness, image, or frontend — FR-099) ---
#GOOGLE_AI=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
